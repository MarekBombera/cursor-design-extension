{
	"name": "cursor-design",
	"displayName": "cursor-design",
	"version": "0.1.0",
	"description": "Agent-driven live HTML artboard for Cursor (MCP + webview, no in-panel chat).",
	"categories": [
		"Other"
	],
	"keywords": [
		"artboard",
		"cursor",
		"design",
		"mcp",
		"webview"
	],
	"homepage": "https://github.com/marekbombera/cursor-design-extension",
	"bugs": {
		"url": "https://github.com/marekbombera/cursor-design-extension/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/marekbombera/cursor-design-extension.git"
	},
	"publisher": "cursor-design",
	"main": "./dist/extension.js",
	"scripts": {
		"vscode:prepublish": "pnpm run package",
		"check": "vp check",
		"compile": "vp check --no-fmt && vp pack",
		"watch": "vp pack --watch",
		"watch:pack": "vp pack --watch",
		"package": "vp check --no-fmt && vp pack --minify --no-sourcemap",
		"vsix": "pnpm dlx @vscode/vsce@3.9.2 package --no-dependencies",
		"compile-electron-tests": "tsc -p tsconfig.test.json",
		"test": "vscode-test",
		"coverage": "vp test --coverage",
		"knip": "knip"
	},
	"dependencies": {
		"@modelcontextprotocol/server": "^2.2.0",
		"zod": "^4.2.0"
	},
	"devDependencies": {
		"@modelcontextprotocol/client": "^2.2.0",
		"@types/mocha": "^10.0.10",
		"@types/node": "24.x",
		"@types/vscode": "~1.125.0",
		"@vitest/coverage-v8": "^5.0.5",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.1.0",
		"fast-check": "^4.10.2",
		"knip": "^6.42.1",
		"typescript": "^7.0.2",
		"vite-plus": "1.3.0"
	},
	"overrides": {
		"diff": "^8.0.4",
		"serialize-javascript": "^7.0.6"
	},
	"contributes": {
		"commands": [
			{
				"command": "cursor-design.openArtboard",
				"title": "Open Artboard",
				"category": "Cursor Design"
			},
			{
				"command": "cursor-design.revealDesignFolder",
				"title": "Reveal Design Folder",
				"category": "Cursor Design"
			},
			{
				"command": "cursor-design.exportHandoff",
				"title": "Export Handoff",
				"category": "Cursor Design"
			}
		]
	},
	"activationEvents": [
		"onStartupFinished"
	],
	"extensionKind": [
		"workspace"
	],
	"engines": {
		"vscode": "^1.128.0"
	},
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": false,
			"description": "Cursor Design writes and previews workspace HTML as executable artboard content."
		}
	}
}
