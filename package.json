{
	"name": "vibeboard",
	"displayName": "Vibeboard: Agent Design Canvas",
	"version": "0.1.0",
	"description": "Agent design canvas for Cursor and VS Code: your AI agent writes live HTML artboards through a local MCP server; you review, comment and tweak them in a panel.",
	"categories": [
		"Other"
	],
	"keywords": [
		"agent",
		"artboard",
		"canvas",
		"cursor",
		"design",
		"mcp",
		"webview"
	],
	"homepage": "https://github.com/MarekBombera/vibeboard",
	"bugs": {
		"url": "https://github.com/MarekBombera/vibeboard/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/MarekBombera/vibeboard.git"
	},
	"publisher": "bombic",
	"main": "./dist/extension.js",
	"scripts": {
		"vscode:prepublish": "pnpm run package",
		"check": "vp check && node scripts/check-agent-rules.mjs",
		"verify": "vp check && node scripts/check-agent-rules.mjs && knip && knip --production && svelte-check --tsconfig ./tsconfig.webview.json --fail-on-warnings && tsc -p tsconfig.webview-tests.json && vp test && vp pack && vp build -c vite.webview.config.ts",
		"compile": "vp check --no-fmt && vp pack && vp build -c vite.webview.config.ts",
		"watch": "pnpm run --parallel \"/^watch:/\"",
		"watch:pack": "vp pack --watch",
		"watch:webview": "vp build -c vite.webview.config.ts --watch",
		"package": "vp check --no-fmt && vp pack --minify --no-sourcemap && vp build -c vite.webview.config.ts --sourcemap false",
		"vsix": "pnpm dlx @vscode/vsce@3.9.2 package --no-dependencies",
		"test": "vp test",
		"test:browser": "vp build -c vite.webview.config.ts && playwright test -c tests/browser",
		"gallery": "CD_GALLERY=1 pnpm test:browser gallery --no-deps",
		"showcase": "CD_SHOWCASE=1 pnpm test:browser showcase",
		"coverage": "vp test --coverage",
		"knip": "knip"
	},
	"dependencies": {
		"@modelcontextprotocol/server": "^2.4.0",
		"parse5": "8.1.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@medv/finder": "4.0.2",
		"@modelcontextprotocol/client": "^2.4.0",
		"@playwright/test": "^1.65.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "24.x",
		"@types/vscode": "~1.125.0",
		"@vitest/coverage-v8": "^5.1.0",
		"fast-check": "^4.10.2",
		"happy-dom": "^21.0.4",
		"knip": "^6.45.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "~6.0.3",
		"vite-plus": "1.7.0"
	},
	"contributes": {
		"commands": [
			{
				"command": "vibeboard.openArtboard",
				"title": "Open Artboard",
				"category": "Vibeboard"
			},
			{
				"command": "vibeboard.revealDesignFolder",
				"title": "Reveal Design Folder",
				"category": "Vibeboard"
			},
			{
				"command": "vibeboard.exportHandoff",
				"title": "Export Handoff",
				"category": "Vibeboard"
			}
		],
		"mcpServerDefinitionProviders": [
			{
				"id": "vibeboard",
				"label": "Vibeboard"
			}
		]
	},
	"activationEvents": [
		"onStartupFinished"
	],
	"extensionKind": [
		"workspace"
	],
	"icon": "media/icon.png",
	"galleryBanner": {
		"color": "#0d1925",
		"theme": "dark"
	},
	"engines": {
		"vscode": "^1.128.0"
	},
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": false,
			"description": "Vibeboard writes and previews workspace HTML as executable artboard content."
		}
	}
}
