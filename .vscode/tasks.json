// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "compile",
			"type": "shell",
			"command": "pnpm compile",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [],
			"presentation": {
				"reveal": "silent",
				"panel": "shared"
			}
		},
		{
			"label": "watch",
			"dependsOn": ["npm: watch:pack", "npm: watch:webview"],
			"presentation": {
				"reveal": "never"
			},
			"group": "build"
		},
		{
			"type": "npm",
			"script": "watch:pack",
			"group": "build",
			"problemMatcher": {
				"owner": "vp-pack",
				"pattern": {
					"regexp": "^\\[(?!ELIFECYCLE)[A-Z_]+\\] (.+)$",
					"message": 1
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "Build start|changed, rebuilding",
					"endsPattern": "Rebuilt in \\d+ms|Build failed"
				}
			},
			"isBackground": true,
			"label": "npm: watch:pack",
			"presentation": {
				"group": "watch",
				"reveal": "never"
			}
		},
		{
			"type": "npm",
			"script": "watch:webview",
			"group": "build",
			"problemMatcher": {
				"owner": "vite-webview",
				"pattern": {
					"regexp": "^.*$",
					"message": 0
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "transforming|building for|vite v",
					"endsPattern": "built in|watching for file changes"
				}
			},
			"isBackground": true,
			"label": "npm: watch:webview",
			"presentation": {
				"group": "watch",
				"reveal": "never"
			}
		}
	]
}
