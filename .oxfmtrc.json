{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"semi": true,
	"singleQuote": true,
	"useTabs": true,
	"printWidth": 100,
	"ignorePatterns": [
		"**/dist/**",
		"**/out/**",
		"**/node_modules/**",
		"**/.vscode-test/**",
		"**/.agents/**",
		"**/.cursor/**",
		"**/.claude/**",
		"**/blueprint/**",
		"src/types/vscode.cursor.d.ts"
	]
}
